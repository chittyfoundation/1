// ChittyPrime — Cloudflare Workers configuration
{
  "name": "chittyprime",
  "main": "connectivity/api/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "chittyprime.chitty.cc/*",
      "zone_name": "chitty.cc"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "SERVICE_NAME": "chittyprime"
  },
  "tail_consumers": [
    {
      "service": "chittytrack"
    }
  ],
  "build": {
    "command": "npm run build:api"
  },
  "observability": {
    "enabled": true
  }
}
